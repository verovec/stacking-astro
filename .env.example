# Copy to .env and adjust. Real .env is git-ignored; never commit secrets.

# --- Postgres (the only containerized stateful service) ---
POSTGRES_USER=astro
POSTGRES_PASSWORD=astro
POSTGRES_DB=astrostack
POSTGRES_PORT=5432

# Connection string used by the host-run Go engine (talks to the compose Postgres).
DATABASE_URL=postgres://astro:astro@localhost:5432/astrostack?sslmode=disable

# --- HTTP API (host) ---
API_ADDR=:8080
LOG_LEVEL=info

# --- Data directories (host paths the engine reads/writes) ---
# Root that the web UI is allowed to browse for capture folders. Put your captures here (one folder
# per target/night) or point this at wherever they already live. It must EXIST — a clone has none of
# these directories, since they are all git-ignored.
# Kept as ./input so host-dev browses the same root the container does (compose.yaml pins the engine
# to ${PWD}/input); pointing them at different folders makes the same capture visible in one mode and
# invisible in the other.
ASTRO_DATA_DIR=./input
# Extra absolute roots the UI may also browse (":" or "," separated), on top of ASTRO_DATA_DIR and
# the removable-media defaults — e.g. an external drive holding older captures.
ASTRO_BROWSE_ROOTS=
# Scratch space for intermediate FITS / sequences during processing.
ASTRO_WORK_DIR=./work
# Set to 1 to KEEP run scratch dirs after jobs finish (debugging). By default the engine sweeps
# stale <work>/run_* dirs on boot and after each job — a day of runs is tens-to-hundreds of GB.
ASTRO_KEEP_WORK=
# Where final stacks and reports are written.
ASTRO_OUTPUT_DIR=./output
# Persistent calibration-master library (darks/flats/bias reused across sessions).
ASTRO_LIBRARY_DIR=./library
# Longest edge (px) of the in-browser frame-preview buffer the API decodes; smaller = less memory.
PREVIEW_MAX_EDGE=1500

# --- Host tools the engine shells out to ---
SIRIL_BIN=/Applications/Siril.app/Contents/MacOS/siril-cli
GIMP_BIN=/Applications/GIMP.app/Contents/MacOS/gimp-console-2.10
# GIMP Script-Fu server the engine drives (shared with the GIMP MCP).
GIMP_HOST=127.0.0.1
GIMP_PORT=10008
FFMPEG_BIN=ffmpeg
# ffprobe locates >8-bit planetary videos so extraction keeps 16 bits (default: ffmpeg's sibling).
#FFPROBE_BIN=ffprobe

# --- Optional astro-AI tools (open-source; invoked, never bundled) ---
# GraXpert: AI background-gradient extraction (replaces Siril subsky when present).
# StarNet++ v2: star removal for star-reduced finishing. Both are optional — when the
# binary is missing the pipeline logs a warning and falls back. Disable per-run with `--no-ai`.
# pip/pipx installs put `graxpert` on PATH (no GraXpert.app), so resolve by name; override with an
# absolute path if you use the .app build. exec.LookPath accepts a bare name or an absolute path.
# HEALTH: the engine deep-probes GraXpert (a real tiny extraction) — a present-but-broken install
# (typically a missing ONNX runtime: "No module named 'onnxruntime'") is treated as ABSENT and shown
# in /api/environment + the UI. Fix a pipx install with:  pipx inject graxpert onnxruntime
GRAXPERT_BIN=graxpert
STARNET_BIN=starnet++
# Offload GraXpert to a host HTTP service (cmd/graxpert-host) so a CONTAINERIZED engine can still use
# the host GPU; empty = run GRAXPERT_BIN locally.
ASTRO_GRAXPERT_URL=
# Pass -gpu true to GraXpert background extraction (Apple Silicon). Denoise batch size (0 = default).
ASTRO_GRAXPERT_GPU=false
ASTRO_GRAXPERT_BATCH=0

# --- Raw development (DSLR / mirrorless / phone) ---
# Camera raws (NEF/CR2/CR3/ARW/RAF/DNG) are developed by LibRaw's dcraw_emu when it is available:
# no per-frame auto-brightening, no baked-in orientation and an exactly-known transfer curve — the
# photometric consistency stacking needs. `brew install libraw` (macOS) / `libraw-bin` (Linux).
# macOS `sips` is the fallback: it works, but applies Apple's opaque tone curve and cannot disable
# white balance, which clips a narrowband subject in its one signal-carrying channel.
DCRAW_BIN=dcraw_emu
SIPS_BIN=sips

# --- Optional local-AI-agent finish supervisor (opt-in) ---
# When a run opts in (the web UI's "Run with local AI agent" checkbox, or `astrostack process
# --supervise`), the engine drives a host-run, OpenAI-compatible model server to re-render only the
# fast GIMP composite a few times — each judged by a local vision model — and keeps the best. Off by
# default; an empty/unreachable URL falls back to the normal finish.
#
# Start the server with `just run-ia-model` (mlx-vlm in a local .venv-ia; first run downloads ~26 GB).
# ASTRO_LLM_MODEL is the Hugging Face MLX repo — BOTH the id the engine sends AND what the recipe
# serves. 96 GB M2 Max default: Qwen2.5-VL-32B 6-bit. Alternatives: -8bit (~34 GB, max fidelity),
# -4bit (~18 GB, lightest), or Qwen2.5-VL-72B-Instruct-4bit (~40 GB). LM Studio is a drop-in fallback.
# Left COMMENTED on purpose. The Go default is already http://127.0.0.1:1234/v1, so host mode is
# unaffected — but compose does not inject .env into containers, it only interpolates with it, so
# an uncommented loopback here overrides the stack's own host.docker.internal default and points
# the containerized engine's model client at the container itself. Set it only to override both.
#ASTRO_LLM_URL=http://127.0.0.1:1234/v1
ASTRO_LLM_PORT=1234
ASTRO_LLM_MODEL=mlx-community/Qwen2.5-VL-32B-Instruct-6bit
# Image wire-format for the vision request: "openai" ({image_url:{url}}) or "mlxvlm" ({input_image}).
# Default openai; switch to mlxvlm only if mlx-vlm rejects the OpenAI image block.
ASTRO_LLM_IMAGE_FORMAT=openai
# Max seconds for ONE completion. A vision reply on a large image (esp. the 32B, non-streamed) can take
# minutes, so this is generous; raise it for very long tasks, or set 0 for no limit. Health checks are
# unaffected (they use a short 5s probe). The stack's nginx caps at 3600s — bump both to go higher.
ASTRO_LLM_TIMEOUT_SEC=3600
# Extra tone/policy text appended to the AstroAgent chat system prompt (the grounding rules + knob menu
# that keep replies factual and on-stack stay fixed in code). Leave empty for the default behaviour.
ASTRO_LLM_ASSIST_PROMPT_EXTRA=
# Hugging Face token (free: https://huggingface.co/settings/tokens). STRONGLY recommended — without it
# the first `just run-ia-model` download is throttled hard (~hours for the 26 GB 32B). Resumable: set
# it and re-run to finish at full speed. Loaded via dotenv. Secret — never commit your real .env.
HF_TOKEN=

# --- Resource limits (keep a heavy stack from freezing the host) ---
# Siril defaults to ALL cores and 90% of RAM, which thrashes swap and can near-freeze the machine.
# These cap it via Siril's own setcpu/setmem (injected into every script) plus OS niceness.
ASTRO_MAX_CPUS=10            # cap Siril processing threads (setcpu); 0 = Siril default (all cores)
ASTRO_SIRIL_MEM_RATIO=0.5    # fraction of available RAM Siril may use (setmem); 0 = Siril default (0.9)
ASTRO_SIRIL_NICE=10          # lower siril-cli OS priority so the UI stays responsive; 0 = unchanged
ASTRO_MAX_WORKERS=0          # max concurrent jobs in the API worker pool; 0 = runtime.NumCPU()/2

# --- Optional performance opt-ins (defaults keep output byte-identical) ---
# Run the joint AI colour denoise on a downscaled copy and transfer only the CHROMA back (per-pixel
# luminance preserved exactly): ~scale² of the cost. Best for LRGB sessions (L carries the detail);
# RGB-only luminance noise is untouched by design. 1.0 = full-resolution pass (default).
ASTRO_DENOISE_SCALE=1.0
# Stack up to N deep-sky channels concurrently; each Siril instance gets an equal share of the
# CPU/memory budget above. 1 = the proven serial loop (default).
ASTRO_CHANNEL_PARALLEL=1
# Memory budget (GB) for the cross-frame satellite-trail mask; caps how much of the streamed basis is
# held at once. Empty = derive it from the machine.
ASTRO_TRAIL_MASK_MEM_GB=
# Set to "off" to stop the finish supervisor warm-starting from previous runs of the same target.
ASTRO_SUPERVISE_HISTORY=

# --- Plate-solving + SPCC color calibration ---
# Rig optics (the FITS rarely carries FOCALLEN); used to plate-solve before SPCC.
ASTRO_FOCAL_MM=740            # Takahashi FC-100 DF native focal length (mm)
ASTRO_PIXEL_UM=3.8            # ASI1600MM Pro pixel size (µm)
# SPCC sensor + filter + white-reference names. These MUST match Siril's spcc-database entries
# EXACTLY (case + spacing) or SPCC aborts and the sky goes brown. The ASI1600MM Pro's sensor entry is
# "ZWO ASI1600MM" (NOT "...Pro" — that name does not exist in the DB). A mono sensor also needs the
# per-channel filter names; these are ZWO's CMOS-optimized LRGB set. (See the DB under
# "~/Library/Application Support/org.siril.Siril/siril-spcc-database/".) Keep the quotes: `just`
# loads this file as dotenv and REJECTS an unquoted value containing a space — every recipe would
# then fail with "Error parsing line" before it runs.
ASTRO_SPCC_SENSOR="ZWO ASI1600MM"
ASTRO_SPCC_RFILTER="ZWO Optimized for CMOS Red"
ASTRO_SPCC_GFILTER="ZWO Optimized for CMOS Green"
ASTRO_SPCC_BFILTER="ZWO Optimized for CMOS Blue"
ASTRO_SPCC_WHITEREF="Average Spiral Galaxy"
# SPCC OSC sensor for the milkyway/nightscape path (the one-shot camera, e.g. a DSLR). Blank disables
# SPCC for nightscapes — a phone sensor is rarely in Siril's SPCC DB — using the neutralization path.
ASTRO_NIGHTSCAPE_OSC_SENSOR=
ASTRO_PLATESOLVE_CATALOG=     # blank = auto: localgaia when the offline catalogue is installed, else Siril online
# Siril's bundled object catalogues (name→coords); blank = derived from SIRIL_BIN's app bundle.
ASTRO_SIRIL_CATALOG_DIR=
# OFFLINE Gaia DR3 catalogues (one-time `just download-catalogues`, optional `-spcc` for the chunks):
# with the astrometric file present, plate-solving — and therefore SPCC colour calibration — needs no
# network, on the host and in the Docker engine alike. Blank = <ASTRO_LIBRARY_DIR>/catalogues defaults.
ASTRO_GAIA_ASTRO_CAT=         # astrometric extract FILE (siril_cat_healpix8_astro.dat)
ASTRO_GAIA_XPSAMP_DIR=        # DIRECTORY holding siril_cat1_healpix8_xpsamp_NN.dat chunks (partial set OK)
ASTRO_LOCAL_ASNET=false       # true = solve via a local astrometry.net install instead
ASTRO_SPCC_CATALOG=           # blank = Siril prefers local xp_sampled when installed; or gaia|localgaia
ASTRO_DEEPSTAR_CAT=           # DEEP star-name catalogue (ATHYG, `just download-deepstars`); absent = embedded mag-9 extract

# --- Observing site + rig (drives the Mosaic planner's alt/az, FOV and tile math) ---
# Defaults to Paris so the page works out of the box; the UI can override per plan.
ASTRO_LAT=48.8566            # observer latitude (degrees, +N)
ASTRO_LON=2.3522             # observer longitude (degrees, +E)
ASTRO_TIMEZONE=Europe/Paris  # IANA timezone for local-time display
# Aperture + sensor dimensions complete the rig (ASTRO_FOCAL_MM/ASTRO_PIXEL_UM above are reused) so the
# mosaic planner can compute tile fields of view.
ASTRO_APERTURE_MM=100        # Takahashi FC-100 DF aperture (mm)
ASTRO_SENSOR_W=4656          # sensor width (px) — ASI1600MM Pro
ASTRO_SENSOR_H=3520          # sensor height (px) — ASI1600MM Pro
# Visual-observing kit carried on equipment setups: "focalMM:apparentFOVdeg[:label]" items, comma-separated.
ASTRO_EYEPIECES=30:68:30mm,18:65:18mm,10:60:10mm,6:60:6mm
ASTRO_BARLOW=1               # Barlow/amplifier factor applied to focal length (image scale, FOV, power); 1 = none
ASTRO_REDUCER=1              # focal reducer applied on top of the Barlow, e.g. 0.66; 1 = none

# --- Cross-session reuse (grow integration + deepen calibration) ---
# Every run is recorded in the frame catalog. When enabled, a new run folds in prior light frames of
# the same target (matched by RA/Dec cone, else normalized name) to grow total integration, and pools
# every matching raw bias/dark across sessions into deeper, lower-noise masters. Flats stay
# session-specific. The UI auto-discovers reusable data and lets you deselect nights before running.
ASTRO_REUSE_ENABLED=true             # false disables reuse (runs single-session, still records catalog)
ASTRO_REUSE_CONE_DEG=0.5             # coordinate-match radius for same-target light frames (degrees)
ASTRO_REUSE_DARK_RECENCY_DAYS=0      # ignore darks older than N days (0 = no age limit)
ASTRO_REUSE_TEMP_TOL_C=5.0           # dark/light temperature match tolerance (°C)

# --- Adminer (compose profile "tools") ---
ADMINER_PORT=8081

# --- Frontend dev server (host vite) ---
WEB_PORT=5173
# Base URL the frontend uses to reach the API. Leave EMPTY: the app is same-origin behind a proxy that
# forwards /api to the engine (nginx in the container image; the Vite dev proxy in host-dev). Set this only
# to point the UI at an engine on a DIFFERENT origin (that origin must then allow CORS + CORP).
VITE_API_BASE=

# --- Production frontend image (compose profile "web") ---
WEB_PORT_PROD=8082

# --- Full-container stack (compose profiles "stack" / "ai") -------------------------------------------
# `just stack` runs the whole app in containers (db + engine + frontend); the engine image bakes in the
# Linux Siril/GIMP/GraXpert/ffmpeg, so the host tool paths above (SIRIL_BIN/GIMP_BIN/…) do NOT apply
# there. This block only affects the containers. Daily macOS dev is unchanged (`just up` + `just dev`).
#
# nginx /api upstream: `just stack` overrides this to engine:8080; the default targets the host engine.
API_UPSTREAM=host.docker.internal:8080
# Published port for the containerized engine's API (host-dev uses API_ADDR=:8080 directly).
ENGINE_PORT=8080
# The engine image builds for the HOST arch (arm64 on Apple Silicon, amd64 on Linux), so Siril/GIMP run
# natively — no emulation. On arm64 Siril comes from the distro package (no arm64 AppImage exists), a
# slightly older version than the 1.4.x x86_64 AppImage used on amd64. Cross-build for a server from a
# Mac with: docker buildx build --platform linux/amd64 -f docker/engine.Dockerfile .
# Data: the stack mounts ./input, ./library, ./output, ./work at their SAME absolute host paths inside
# the engine and runs with the repo root as CWD, so the ABSOLUTE paths the host engine stored in Postgres
# + run.json resolve unchanged — your previous Library, Runs, Tasks and cross-session reuse keep working,
# and host-dev ⇄ stack are interchangeable. Keep captures under ./input (or symlink them there) and run
# `just stack` from the repo root. input is mounted read-WRITE: the pipeline only reads it, but the

# Removable/external drives for Storage -> Drives, mounted READ-ONLY at the same path so it matches
# ASTRO_BROWSE_ROOTS and the paths the UI shows. The default below is right on macOS (Docker Desktop
# shares /Volumes); leave it commented unless you are on a Linux server, where you want your own
# mount root, e.g. /media or /mnt.
#ASTRO_DRIVES_DIR=/Volumes

# Linux only: run the engine as the UID/GID that owns those dirs so it can write library/output/work.
# Find yours with `id -u` / `id -g`. On Docker Desktop (macOS) leave unset (ownership is mapped).
UID=
GID=

# Finish-supervisor VLM for the stack — the engine is backend-agnostic (OpenAI-compatible), so pick one:
#   • macOS: keep the model NATIVE (Metal) — run `just run-ia-model`, and point the container at the
#     host. Docker on macOS has no GPU, so the VLM cannot run in a container there.
#       ASTRO_LLM_URL=http://host.docker.internal:1234/v1
#       ASTRO_LLM_MODEL=mlx-community/Qwen2.5-VL-32B-Instruct-6bit
#   • Linux+GPU: run the `ai` (Ollama) container via `just stack-ai` + `just ai-pull` (needs
#     nvidia-container-toolkit), then:
#       ASTRO_LLM_URL=http://ai:11434/v1
#       ASTRO_LLM_MODEL=qwen2.5vl:32b
# Leave ASTRO_LLM_URL/ASTRO_LLM_MODEL unset to run the stack WITHOUT AI (the supervisor is opt-in and
# soft-fails; a normal job never calls it). `just stack` does not pull or start the model.
OLLAMA_TAG=0.6.8          # Ollama image tag for the `ai` service — set one you've verified for your GPU/driver
OLLAMA_PORT=11434

